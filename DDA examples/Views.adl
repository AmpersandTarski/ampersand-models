CONTEXT Views

   RELATION personFirstName[Person*FirstName]  -- uit SIAM/Person.adl
   RELATION personLastName[Person*LastName]  -- uit SIAM/Person.adl
   RELATION gezinslid[Gastgezin*Person]  -- uit NutwenteDataModel.adl
   RELATION woonplaats[Adres*Plaatsnaam] [UNI]
   RELATION plaatsingadres[Gastgezin*Adres] [INJ]
   RELATION gezinslid[Gastgezin*Person] -- is injectief omdat RULE OntdubbelGastgezinnen deze relatie injectief houdt.
   RELATION straatHuisnummer[Adres*StraatHuisnummer] [UNI]


VIEW Person: Person
   { personFirstName : personFirstName
   , space : TXT " "
   , achternaam: personLastName
   }
ENDVIEW

VIEW Gastgezin: Gastgezin DEFAULT
   { voornaam : gezinslid;personFirstName
   , space : TXT " "
   , achternaam : gezinslid;personLastName
   , lpar : TXT " ("
   , adres : plaatsingadres;straatHuisnummer
   , spatie : TXT ", "
   , plaats : plaatsingadres;woonplaats
   , rpar : TXT ")"
   }
ENDVIEW

ENDCONTEXT
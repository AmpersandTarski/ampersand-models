CONTEXT Kleene

RELATION r[Persoon]
RELATION rPlus[Persoon]
ENFORCE rPlus >: (r\/rPlus;r) - V;rPlusShrinking;V
ENFORCE rPlus :< r \/ -(V;rPlusShrinking;V - V;rPlusGrowing;V)

-- ROLE User MAINTAINS EnforceRMinIns
-- RULE EnforceRMinIns : -(V;rPlusGrow;V) /\ (r-rPlus;r) |- rMin
ENFORCE rMin >: (r-rPlus;r) - V;rPlusGrowing;V
RELATION rMin[Persoon]

RELATION inCycle[Persoon]
ENFORCE inCycle := r /\ rPlus~

RELATION rPlusGrowing[Persoon]
ENFORCE rPlusGrowing := (r\/rPlus;r) - rPlus
RELATION rPlusShrinking[Persoon]
ENFORCE rPlusShrinking >: rPlus-(r\/rPlus;r) -- - V;rPlusGrow;V
ROLE User MAINTAINS EnforceRPlusDel
RULE EnforceRPlusDel : (V;(rMin-r);V) /\ rPlus |- r
RELATION rMinGrow[Persoon]
ENFORCE rMinGrow := (r-rPlus;r) - rMin
RELATION rMinShrink[Persoon]
ENFORCE rMinShrink := ((rMin/\rPlus;r)-inCycle) - V;rPlusGrowing;V


INTERFACE Closures : "_SESSION";V[SESSION*Persoon] cRud BOX<TABLE>
  [ "Wie?" : I
  , rPlusGrow   : rPlusGrowing   cRud
  , rPlusShrink : rPlusShrinking cRud
  , rMinGrow    : rMinGrow     cRud
  , rMinShrink  : rMinShrink   cRud
  , r           : r            CRUD
  , rPlus       : rPlus        CRUD
  , rMin        : rMin         CRUD
  , inCycle     : inCycle      cRud
  ]
  
POPULATION Persoon CONTAINS [ "Jan", "Katrien", "Marie", "Piet"]
ENDCONTEXT